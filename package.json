{
  "name": "@worldline/aurora-react",
  "private": false,
  "version": "1.41.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/*.css",
    "src/assets/fonts"
  ],
  "exports": {
    "./components": {
      "types": "./dist/components/main.d.ts",
      "import": "./dist/components/main.js"
    },
    "./styles.css": "./dist/assets/styles/styles.css",
    "./fonts/*": {
      "import": "./src/assets/fonts/*"
    },
    "./fonts.css": "./src/assets/fonts/fonts.css"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run icons:generate",
    "wli": "npm login --registry=https://registry.npmjs.org/ && npm i",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "slint": "npx stylelint \"**/*.css\"",
    "slint:fix": "npx stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "ncui": "npx npm-check-updates -i",
    "prestorybook": "npm run icons:generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start-storybook": "npx serve storybook-static",
    "test:setup": "npx playwright install chromium --with-deps",
    "test": "vitest",
    "test:ci": "cross-env CI=true vitest run --reporter=html --reporter=default --no-color",
    "test:report": "vitest run --reporter=html; npm run test:serve-report",
    "test:unit": "vitest run --project=unit --watch",
    "test:storybook": "vitest run --project=storybook --watch",
    "test:visual": "vitest run --project=visual --passWithNoTests",
    "test:visual:report": "npm run test:visual -- --reporter=html; npm run test:serve-report",
    "test:visual:update": "npm run test:visual -- --update",
    "test:serve-report": "npx vite preview --outDir .vitest-reports --open",
    "coverage": "npm run test -- --coverage --project=unit --project=storybook",
    "typecheck": "tsc -b",
    "icons:generate": "npx @svgr/cli --config-file svgr.config.js --no-prettier -- src/assets/icons",
    "icons:download": "node scripts/download-icons.ts"
  },
  "dependencies": {
    "@react-aria/live-announcer": "3.5.0",
    "@worldline/aurora-design-tokens": "1.12.1",
    "@internationalized/date": "^3.12.1"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "classnames": "^2.5.1",
    "react": "^19.2.6",
    "react-aria-components": "~1.17.0",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.0",
    "@commitlint/config-conventional": "21.0.0",
    "@eslint-react/eslint-plugin": "5.7.7",
    "@eslint/js": "10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/gitlab": "13.3.2",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-mcp": "0.6.0",
    "@storybook/addon-vitest": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@stylistic/eslint-plugin": "5.10.0",
    "@svgr/cli": "8.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.6",
    "@vitest/coverage-v8": "4.1.6",
    "@vitest/ui": "4.1.6",
    "cross-env": "10.1.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-dom": "5.7.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-storybook": "10.3.6",
    "glob": "13.0.6",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "lefthook": "2.1.6",
    "playwright": "1.60.0",
    "prettier": "3.8.3",
    "rollup-preserve-directives": "1.1.3",
    "sass-embedded": "1.99.0",
    "semantic-release": "25.0.3",
    "storybook": "10.3.6",
    "stylelint": "17.11.0",
    "stylelint-config-clean-order": "8.0.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "5.0.3",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "testcontainers": "11.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "unplugin-dts": "1.0.0",
    "vite": "8.0.12",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vitest": "4.1.6"
  }
}
