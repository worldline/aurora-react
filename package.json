{
  "name": "@worldline/aurora-react",
  "private": false,
  "version": "1.9.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles/*.css",
    "src/assets/fonts"
  ],
  "exports": {
    "./components": {
      "import": "./dist/components/main.js",
      "types": "./dist/main.d.ts"
    },
    "./styles.css": "./dist/assets/styles.css",
    "./fonts/*": {
      "import": "./src/assets/fonts/*"
    },
    "./fonts.css": "./src/assets/fonts/fonts.css"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run icons:generate",
    "wli": "npm login --registry=https://registry.npmjs.org --auth-type=web && npm i",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "slint": "npx stylelint \"**/*.css\"",
    "slint:fix": "npx stylelint \"**/*.css\" --fix",
    "ncui": "npx npm-check-updates -i",
    "prestorybook": "npm run icons:generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:setup": "npx playwright install chromium --with-deps",
    "test": "vitest",
    "test:unit": "vitest run --project=unit --watch",
    "test:storybook": "vitest run --project=storybook --watch",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "icons:generate": "npx @svgr/cli  --config-file svgr.config.js -- src/assets/icons/svg",
    "import-icon": "npx tsx import-icon.ts"
  },
  "dependencies": {
    "@worldline/aurora-design-tokens": "1.5.0"
  },
  "peerDependencies": {
    "classnames": "^2.5.1",
    "react": "^19.2.1",
    "react-aria-components": "~1.15.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "2.13.0",
    "@eslint/js": "9.39.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/npm": "13.1.4",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@storybook/addon-a11y": "10.2.12",
    "@storybook/addon-docs": "10.2.12",
    "@storybook/addon-vitest": "10.2.12",
    "@storybook/react-vite": "10.2.12",
    "@stylistic/eslint-plugin": "5.9.0",
    "@svgr/cli": "8.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-dom": "2.13.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-storybook": "10.2.12",
    "glob": "13.0.6",
    "globals": "17.3.0",
    "jsdom": "28.1.0",
    "lefthook": "2.1.1",
    "playwright": "1.58.2",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rollup-preserve-directives": "1.1.3",
    "sass-embedded": "1.97.3",
    "semantic-release": "25.0.3",
    "storybook": "10.2.12",
    "stylelint": "17.4.0",
    "stylelint-config-clean-order": "8.0.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "5.0.3",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  }
}
